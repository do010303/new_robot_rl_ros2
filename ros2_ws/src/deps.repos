## vcstool dependency file -------------------------------------------------
## Clone external ROS 2 packages that are NOT included in this repository.
##
## Usage (run once after cloning the repo):
##   cd ~/new_rl_ros2/ros2_ws/src
##   vcs import --input deps.repos .
##
## These packages are gitignored because they are third-party dependencies
## that should be fetched at setup time, not vendored into this repository.
## ---------------------------------------------------------------------------
repositories:
  gz_ros2_control:
    type: git
    url: https://github.com/ros-controls/gz_ros2_control.git
    version: humble
