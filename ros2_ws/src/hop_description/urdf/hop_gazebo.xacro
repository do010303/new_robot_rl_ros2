<?xml version="1.0" ?>
<robot name="hop" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Gazebo Harmonic (gz-sim8) Plugins ==================== -->

  <!-- Gazebo material colors (URDF materials don't transfer to SDF automatically) -->
