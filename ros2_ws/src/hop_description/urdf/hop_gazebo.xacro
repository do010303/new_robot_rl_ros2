  <!-- ==================== Gazebo Harmonic System Plugins ==================== -->

  <gazebo>
    <!-- Joint State Publisher: publishes joint states to Gazebo topics -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>arm_joint_1</joint_name>
      <joint_name>arm_joint_2</joint_name>
      <joint_name>arm_joint_3</joint_name>
      <joint_name>arm_joint_4</joint_name>
      <joint_name>arm_joint_5</joint_name>
      <joint_name>arm_joint_6</joint_name>
      <joint_name>rotor_joint_1</joint_name>
      <joint_name>rotor_joint_2</joint_name>
      <joint_name>rotor_joint_3</joint_name>
      <joint_name>rotor_joint_4</joint_name>
    </plugin>

    <!-- Joint Position Controller for robotic arm joints -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint_1</joint_name>
      <p_gain>1.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint_2</joint_name>
      <p_gain>1.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint_3</joint_name>
      <p_gain>1.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint_4</joint_name>
      <p_gain>0.5</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.05</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint_5</joint_name>
      <p_gain>0.5</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.05</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint_6</joint_name>
      <p_gain>0.5</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.05</d_gain>
    </plugin>
  </gazebo>

</robot>
