<?xml version="1.0"?>
<sdf version="1.9">
  <world name="drone_aruco_world">

    <!-- Physics tối ưu cho drone (DART solver, bước 4ms) -->
    <physics name="default_physics" default="true" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene: ánh sáng tốt cho ArUco detection -->
    <scene>
      <ambient>0.9 0.9 0.9 1.0</ambient>
      <background>0.6 0.7 0.9 1.0</background>
      <shadows>false</shadows>
    </scene>

    <!-- Ánh nắng chính -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.1 0.0 -1</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Fill light bổ sung -->
    <light name="fill_light" type="directional">
      <pose>-5 -5 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 0.5 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ground plane (50x50m, cỏ xanh) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.20 1</ambient>
            <diffuse>0.25 0.45 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ArUco Target Board
         Đặt ở x=5m, z=2.4m (tầm camera drone bay ở 2.4m độ cao)
         Board xoay 180° quanh Z → markers nhìn về hướng -X (hướng về drone)
         Drone sẽ takeoff từ x=0 và bay về phía x=+5
         ============================================================ -->

    <!-- Marker 0 — Top-Left của board -->
    <include>
      <uri>model://aruco_marker_0</uri>
      <name>marker_0</name>
      <pose>5.0  0.055  2.455  0 0 3.1416</pose>
    </include>

    <!-- Marker 1 — Top-Right -->
    <include>
      <uri>model://aruco_marker_1</uri>
      <name>marker_1</name>
      <pose>5.0 -0.055  2.455  0 0 3.1416</pose>
    </include>

    <!-- Marker 2 — Bottom-Right -->
    <include>
      <uri>model://aruco_marker_2</uri>
      <name>marker_2</name>
      <pose>5.0 -0.055  2.305  0 0 3.1416</pose>
    </include>

    <!-- Marker 3 — Bottom-Left -->
    <include>
      <uri>model://aruco_marker_3</uri>
      <name>marker_3</name>
      <pose>5.0  0.055  2.305  0 0 3.1416</pose>
    </include>

    <!-- Board trắng nền (200mm x 200mm) -->
    <model name="aruco_board_surface">
      <static>true</static>
      <pose>5.002 0 2.38 0 1.5708 0</pose>
      <link name="board_link">
        <visual name="board_visual">
          <geometry>
            <box><size>0.30 0.30 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.97 0.97 0.97 1</ambient>
            <diffuse>0.97 0.97 0.97 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <collision name="board_collision">
          <geometry>
            <box><size>0.30 0.30 0.002</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Cột đỡ board (để board không bay) -->
    <model name="board_pole">
      <static>true</static>
      <pose>5.05 0 1.2 0 0 0</pose>
      <link name="pole_link">
        <visual name="pole_visual">
          <geometry>
            <cylinder><radius>0.02</radius><length>2.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <geometry>
            <cylinder><radius>0.02</radius><length>2.4</length></cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Vòng tròn đánh dấu vị trí takeoff của drone (x=0, y=0) -->
    <model name="takeoff_marker">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="marker_link">
        <visual name="circle_visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.01</length></cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.9 0.0 0.8</ambient>
            <diffuse>1.0 0.9 0.0 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trục tọa độ thế giới (debug) -->
    <model name="origin_frame">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <!-- X axis: đỏ -->
      <link name="x_axis">
        <pose>0.5 0 0.005 0 1.5708 0</pose>
        <visual name="x_vis">
          <geometry><cylinder><radius>0.01</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
      <!-- Y axis: xanh lá -->
      <link name="y_axis">
        <pose>0 0.5 0.005 1.5708 0 0</pose>
        <visual name="y_vis">
          <geometry><cylinder><radius>0.01</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Camera GUI: view từ phía drone, nhìn về board -->
    <gui fullscreen='false'>
      <camera name='user_camera'>
        <pose>-3 -2 4 0 0.4 0.4</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
